{
    "name": "antivibe-ai",
    "displayName": "Antivibe.ai",
    "description": "Milestone-based coding tutor: learn Python, C++ and Java - fundamentals, OOP and DSA - by writing the code yourself, with lessons, instant tests and progressive hints",
    "version": "0.4.0",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Education"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "antivibe.continue",
                "title": "Antivibe: Continue Learning",
                "category": "Antivibe",
                "icon": "$(play)"
            },
            {
                "command": "antivibe.startProblem",
                "title": "Antivibe: Pick an Exercise",
                "category": "Antivibe"
            },
            {
                "command": "antivibe.openLesson",
                "title": "Antivibe: Open Lesson",
                "category": "Antivibe"
            },
            {
                "command": "antivibe.checkSolution",
                "title": "Antivibe: Check My Solution",
                "category": "Antivibe"
            },
            {
                "command": "antivibe.getHint",
                "title": "Antivibe: Get Hint",
                "category": "Antivibe"
            },
            {
                "command": "antivibe.refresh",
                "title": "Antivibe: Refresh Learning Path",
                "category": "Antivibe",
                "icon": "$(refresh)"
            },
            {
                "command": "antivibe.resetProgress",
                "title": "Antivibe: Reset Progress (Start Again)",
                "category": "Antivibe",
                "icon": "$(discard)"
            },
            {
                "command": "antivibe.openHistory",
                "title": "Antivibe: Open My History",
                "category": "Antivibe"
            },
            {
                "command": "antivibe.chooseLanguage",
                "title": "Antivibe: Choose Language",
                "category": "Antivibe",
                "icon": "$(globe)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "antivibe",
                    "title": "Antivibe",
                    "icon": "media/antivibe.svg"
                }
            ]
        },
        "views": {
            "antivibe": [
                {
                    "id": "antivibe.curriculum",
                    "name": "Learning Path"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "antivibe.curriculum",
                "contents": "Antivibe can't reach its backend.\nStart it from the antivibe-backend folder:\nuvicorn main:app --port 8000\n[Try Again](command:antivibe.refresh)",
                "when": "antivibe.backendDown"
            }
        ],
        "keybindings": [
            {
                "command": "antivibe.getHint",
                "key": "ctrl+shift+h",
                "mac": "cmd+shift+h",
                "when": "editorTextFocus"
            },
            {
                "command": "antivibe.checkSolution",
                "key": "ctrl+alt+t",
                "mac": "cmd+alt+t",
                "when": "editorTextFocus && editorLangId =~ /^(python|cpp|c|java)$/"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "antivibe.getHint",
                    "group": "navigation"
                },
                {
                    "command": "antivibe.checkSolution",
                    "group": "navigation",
                    "when": "editorLangId =~ /^(python|cpp|c|java)$/"
                }
            ],
            "view/title": [
                {
                    "command": "antivibe.chooseLanguage",
                    "when": "view == antivibe.curriculum",
                    "group": "navigation@0"
                },
                {
                    "command": "antivibe.continue",
                    "when": "view == antivibe.curriculum",
                    "group": "navigation@1"
                },
                {
                    "command": "antivibe.refresh",
                    "when": "view == antivibe.curriculum",
                    "group": "navigation@2"
                },
                {
                    "command": "antivibe.resetProgress",
                    "when": "view == antivibe.curriculum",
                    "group": "navigation@3"
                }
            ]
        },
        "configuration": {
            "title": "Antivibe.ai",
            "properties": {
                "antivibe.apiUrl": {
                    "type": "string",
                    "default": "http://localhost:8000/api",
                    "description": "Base URL of the Antivibe backend API."
                },
                "antivibe.pythonPath": {
                    "type": "string",
                    "default": "python",
                    "description": "Python 3 interpreter used to run your solutions against the tests."
                },
                "antivibe.lockMilestones": {
                    "type": "boolean",
                    "default": true,
                    "description": "Keep each milestone locked until every exercise in the one before it is solved. Turn off to open any exercise."
                },
                "antivibe.language": {
                    "type": "string",
                    "enum": [
                        "python",
                        "cpp",
                        "java"
                    ],
                    "enumDescriptions": [
                        "Python",
                        "C++ (needs g++)",
                        "Java (needs a JDK)"
                    ],
                    "default": "python",
                    "description": "The language the Learning Path shows. Progress is kept separately for each language."
                },
                "antivibe.cppCompiler": {
                    "type": "string",
                    "default": "g++",
                    "description": "C++ compiler used to build your C++ solutions (g++ or clang++)."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile && node --test out/test/unit/",
        "test:integration": "npm run compile && node scripts/run-integration.mjs"
    },
    "devDependencies": {
        "@types/node": "^18.19.0",
        "@types/vscode": "~1.85.0",
        "typescript": "^4.9.4"
    }
}
